{
  "checks": [
    {
      "kind": "must_not_be_zero",
      "name": "the stream arrived",
      "reads": "rtp_received",
      "why": "every figure in this document is computed over these datagrams, so a run that received none makes each of them an absence rather than a number"
    },
    {
      "kind": "must_not_be_zero",
      "name": "audio was decoded and not merely concealed",
      "reads": "frames_played",
      "why": "the concealer produces plausible samples from an empty stream indefinitely, so a callback count, an underrun count of zero and a continuity figure are all consistent with a path that carried nothing; a decoded frame is not"
    },
    {
      "kind": "must_be_zero",
      "name": "every sample the stream produced reached the device",
      "population": "samples_expected",
      "reads": "continuity_hole",
      "why": "this is the criterion the phase turns on: expected counts every per-channel sample the playout cursor travelled and played counts the ones the producer deposited, with a gap concealment credited because the waveform continued across it and an underrun refused because nothing of the stream was there. The population is the expected samples, because a hole of zero over an expectation of zero is a run that carried nothing"
    },
    {
      "kind": "must_be_zero",
      "name": "the device was never handed silence",
      "population": "render_callbacks",
      "reads": "render_underruns",
      "why": "a cycle the ring could not fill is a whole IO buffer of silence sent to a device in place of audio, which is audible however small the sample count beside it looks; the population is the cycles, because no cycles means no silence for a trivial reason"
    },
    {
      "kind": "must_be_zero",
      "name": "no frame arrived in time and failed to decode",
      "population": "frames_played",
      "reads": "decode_failures",
      "why": "a payload the decoder refuses is a disagreement between the two ends about the format, which no amount of buffering repairs and which concealment hides completely in every other counter here"
    },
    {
      "kind": "must_be_zero",
      "name": "no packet carried a timestamp off the frame grid",
      "population": "rtp_received",
      "reads": "rtp_off_grid",
      "why": "a timestamp that is not a whole number of frames from the one that anchored the stream is a sender running at another frame duration, and the symptom is a run that conceals everything and plays nothing"
    },
    {
      "bound": 500.0,
      "kind": "must_be_below",
      "name": "decode p99 under a tenth of the frame",
      "reads": "decode_p99_us",
      "why": "a tenth of the 5 ms frame is 500 us, and the producer has to decode and deposit inside its period or the device finds an empty ring; p99 rather than the mean, because a frame late once every hundred is a click a listener hears"
    },
    {
      "kind": "must_be_within",
      "name": "the left channel arrives as its own tone",
      "reads": "tone_left_hz",
      "target": 997.0,
      "tolerance": 5.0,
      "why": "a packet count and a callback count agree just as happily when the path carries digital silence, and this project has read that agreement as success; 997 Hz comes out of the samples that were played, at a window resolution of 2 Hz"
    },
    {
      "kind": "must_be_within",
      "name": "the right channel arrives as its own tone",
      "reads": "tone_right_hz",
      "target": 1997.0,
      "tolerance": 5.0,
      "why": "the two channels carry different frequencies so that channel order is provable across the whole link rather than assumed, and a right channel reading 997 Hz is what a swap looks like"
    },
    {
      "kind": "must_not_be_zero",
      "name": "the played channels stay distinct",
      "reads": "tone_channels_distinct",
      "why": "two channels reading one frequency is consistent with a fold to mono, with one channel encoded twice, and with an analysis reading its own scratch buffer, and every count in this document is consistent with all three"
    }
  ],
