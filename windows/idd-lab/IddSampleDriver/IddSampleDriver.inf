;
; IddSampleDriver.inf
;

[Version]
PnpLockDown=1
Signature="$Windows NT$"
ClassGUID = {4D36E968-E325-11CE-BFC1-08002BE10318}
Class = Display
ClassVer = 2.0
Provider=%ManufacturerName%
CatalogFile=LanPlayIddLab.cat
DriverVer=08/10/2026,0.1.0.0

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$.10.0...22000

[Standard.NT$ARCH$.10.0...22000]
%DeviceName%=MyDevice_Install, Root\LanPlayIddLab
%DeviceName%=MyDevice_Install, LanPlayIddLab

[SourceDisksFiles]
LanPlayIddLab.dll=1

[SourceDisksNames]
1 = %DiskName%

; =================== UMDF Device ==================================

[MyDevice_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=UMDriverCopy

[MyDevice_Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg = MyDevice_HardwareDeviceSettings
; A root-enumerated software device otherwise reaches user mode with a
; descriptor that grants nothing to ordinary callers: the phase sender finds
; the interface, opens it and is refused with error 5, which reads like a
; driver fault and is not one. An elevated session is refused too, so this is
; not something a caller can work around by running as an administrator.
;
; Written as a directive rather than as an AddReg of the same string, because
; the installer converts it to the binary form the PnP manager expects. An
; SDDL string stored under the same value name as text is read as a malformed
; descriptor and the device then fails to start at all, taking the laboratory
; display with it.
;
; The service accounts keep everything they had, since the framework's own host
; opens this device before any caller does. Authenticated users get read and
; write, which is the whole of what the relay needs and is worth no more than
; it sounds: the only thing writable here is a four-byte delay the driver folds
; into one refresh period.
Security = "D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GA;;;LS)(A;;GA;;;NS)(A;;GRGW;;;AU)"

[MyDevice_HardwareDeviceSettings]
HKR,, "UpperFilters",  %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "LanPlayIddLabGroup"

[MyDevice_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[MyDevice_Install.NT.Wdf]
UmdfService=LanPlayIddLab,LanPlayIddLab_Install
UmdfServiceOrder=LanPlayIddLab
UmdfKernelModeClientPolicy = AllowKernelModeClients

[LanPlayIddLab_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%12%\UMDF\LanPlayIddLab.dll
UmdfExtensions = IddCx0102

[DestinationDirs]
UMDriverCopy=12,UMDF ; copy to drivers\umdf

[UMDriverCopy]
LanPlayIddLab.dll

; =================== Generic ==================================

[Strings]
ManufacturerName="LanPlay"
DiskName = "LanPlay IDD-LAB Installation Disk"
DeviceName="LanPlay IDD-LAB 1080p120"

REG_MULTI_SZ  = 0x00010000
REG_SZ        = 0x00000000